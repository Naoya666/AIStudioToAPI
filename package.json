{
    "name": "aistudio-to-api",
    "version": "1.3.7",
    "author": "Ellinav, iBenzene, bbbugg",
    "description": "Encapsulate Gemini models on AI Studio as API services.",
    "engines": {
        "node": ">=22.13.0"
    },
    "main": "main.js",
    "scripts": {
        "dev": "concurrently --kill-others --handle-input \"npm run dev:server\" \"npm run dev:ui\"",
        "dev:server": "cross-env NODE_ENV=development nodemon main.js",
        "dev:ui": "vite build --watch",
        "dev:public": "vite --config vite.public.config.js",
        "predev": "npm run build:ui && npm run prepare",
        "build:ui": "vite build && npm run build:public",
        "build:public": "vite build --config vite.public.config.js",
        "preview:ui": "vite preview",
        "start": "cross-env NODE_ENV=production node main.js",
        "quick-start": "cross-env NODE_ENV=production node main.js",
        "prestart": "npm run build:ui",
        "save-auth": "node scripts/auth/saveAuth.js",
        "setup-auth": "node scripts/auth/setupAuth.js",
        "setup-auth-batch": "node scripts/auth/setupAuthBatch.js",
        "prepare": "husky install",
        "lint": "eslint . && stylelint \"{ui,ui-public}/**/*.{css,less}\"",
        "lint:fix": "eslint . --fix && stylelint \"{ui,ui-public}/**/*.{css,less}\" --fix",
        "lint:js": "eslint .",
        "lint:css": "stylelint \"{ui,ui-public}/**/*.{css,less}\"",
        "lint:js:fix": "eslint . --fix",
        "lint:css:fix": "stylelint \"{ui,ui-public}/**/*.{css,less}\" --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "node --test tests/playground-capabilities.test.js tests/playground-stream.test.js tests/model-context-warm-targets.test.js tests/different-proxy-first.test.js tests/model-allowlist.test.js tests/account-tiers.test.js tests/benefit-check-queue.test.js tests/model-transport-client.test.js tests/model-transport-policy.test.js tests/makersuite-auth.test.js tests/makersuite-bridge.test.js tests/makersuite-codec.test.js tests/build-benefit.test.js tests/isolated-dashboard.test.js tests/public-dashboard-cluster.test.js tests/browser-recovery.test.js tests/runtime-supervision.test.js tests/anti-truncation.test.js tests/unified-configuration.test.js tests/configuration-restart.test.js tests/configuration-page.test.js && node tests/model-scheduler.test.js && node tests/scheduled-request.test.js && node tests/browser-workers.test.js && node tests/realtime-dashboard.test.js && node tests/public-dashboard.test.js && node tests/public-dashboard-ui.test.js && node tests/sqlite-storage.test.js && node tests/proxy-pool.test.js && node tests/account-management.test.js && node tests/login-interaction.test.js && node tests/account-login-flow.test.js && node --test --test-concurrency=1 tests/target-session-validation.test.js tests/account-login-browser.test.js tests/accounts-page.test.js tests/frontend-unification.test.js tests/usage-history-ui.test.js",
        "test:transport:browser": "node --test tests/playground-transport.test.js tests/makersuite-browser.test.js tests/makersuite-transport-browser.test.js",
        "test:transport:long": "MODEL_TRANSPORT_LONG_FIXTURE=1 node --test tests/makersuite-transport-browser.test.js"
    },
    "dependencies": {
        "archiver": "^7.0.1",
        "axios": "^1.13.2",
        "basic-auth": "^2.0.1",
        "cookie-parser": "^1.4.6",
        "csv-parse": "^6.2.1",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-session": "^1.18.0",
        "jszip": "^3.10.1",
        "mime-types": "^3.0.2",
        "otplib": "^13.5.0",
        "playwright": "1.59.1",
        "protobufjs": "^7.6.6",
        "socks-proxy-agent": "^8.0.5",
        "ws": "^8.17.0",
        "yaml": "^2.9.1"
    },
    "devDependencies": {
        "@babel/core": "^7.28.5",
        "@babel/eslint-parser": "^7.28.5",
        "@vitejs/plugin-vue": "^5.1.0",
        "@vue/shared": "^3.4.26",
        "concurrently": "^9.2.1",
        "cross-env": "^7.0.3",
        "element-plus": "^2.7.2",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsonc": "^2.18.2",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-sort-keys-fix": "^1.1.2",
        "eslint-plugin-vue": "^9.33.0",
        "husky": "^8.0.3",
        "less": "^4.4.2",
        "less-plugin-clean-css": "^1.6.0",
        "lint-staged": "^14.0.0",
        "nodemon": "^3.1.0",
        "prettier": "^3.7.4",
        "stylelint": "^16.26.1",
        "stylelint-config-standard": "^36.0.1",
        "stylelint-config-standard-less": "^3.0.1",
        "stylelint-less": "^3.0.1",
        "stylelint-order": "^7.0.0",
        "vite": "^5.4.8",
        "vue": "^3.4.26",
        "vue-eslint-parser": "^10.2.0",
        "vue-router": "^4.3.2"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "ui/**/*.vue": [
            "eslint --fix",
            "prettier --write"
        ],
        "ui/locales/*.json": [
            "eslint --fix",
            "prettier --write"
        ],
        "configs/models.json": [
            "eslint --fix",
            "prettier --write"
        ],
        "ui/**/*.{css,less}": [
            "stylelint --fix",
            "prettier --write"
        ],
        "*.{md,yml,yaml}": "prettier --write"
    }
}
