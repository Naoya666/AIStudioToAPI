# ===================================
# Server Configuration
# ===================================

# HTTP server port
PORT=7860

# Server listening host address (use 0.0.0.0 for all interfaces)
HOST=0.0.0.0

# Anonymous, read-only public usage dashboard (served by an isolated HTTP app)
PUBLIC_DASHBOARD_ENABLED=false
PUBLIC_DASHBOARD_PORT=7861
# Defaults to HOST when omitted
PUBLIC_DASHBOARD_HOST=0.0.0.0
# Exact http(s) origins, comma-separated. Empty means same-origin only.
PUBLIC_DASHBOARD_CORS_ORIGINS=
# standalone (default), master (local + agents), agent (authenticated snapshot API only)
# Nodes must use independent account pools. These options require a restart.
PUBLIC_DASHBOARD_ROLE=standalone
PUBLIC_DASHBOARD_SNAPSHOT_INTERVAL_MS=5000
PUBLIC_DASHBOARD_POLL_INTERVAL_MS=5000
PUBLIC_DASHBOARD_FETCH_TIMEOUT_MS=2000
# Must exceed snapshot interval + poll interval + fetch timeout
PUBLIC_DASHBOARD_STALE_AFTER_MS=20000
# Required when enabled with role=agent; use a separately generated secret
PUBLIC_DASHBOARD_AGENT_TOKEN=
# Optional master/agent machine API credential; empty denies all model-health requests
PUBLIC_DASHBOARD_HEALTH_TOKEN=
# Master only. Read each agent's data/public-dashboard-node-id after its first start.
# PUBLIC_DASHBOARD_AGENTS='[{"nodeId":"agent-uuid","name":"Node A","url":"https://agent.example.org","token":"replace-with-agent-secret"}]'
PUBLIC_DASHBOARD_AGENTS=[]

# WebSocket server port for internal browser communication
# ⚠️ DEPRECATED: This environment variable is no longer supported in the current version
# The WebSocket port is now fixed at 9998 and cannot be customized
# WS_PORT=9998

# ===================================
# Authentication Configuration
# ===================================

# Web console username (optional)
# If both username and password are set, both are required to login.
WEB_CONSOLE_USERNAME=

# Web console password (optional)
# If only password is set, the login page will only ask for the password.
# If neither is set, the system falls back to API_KEYS for console login.
WEB_CONSOLE_PASSWORD=

# API keys for authenticating client requests (comma-separated)
# Example: your-api-key-1,your-api-key-2
# If not set, default key "123456" will be used
API_KEYS=

# ===================================
# Security Configuration
# ===================================

# Enable secure cookies (HTTPS only)
# Set to 'true' when using HTTPS, 'false' for HTTP
# Default: false (allows HTTP for easier setup)
SECURE_COOKIES=false

# Login rate limiting configuration
# Maximum failed login attempts allowed within the time window
# Set to 0 to disable rate limiting (not recommended for production)
# Default: 5
RATE_LIMIT_MAX_ATTEMPTS=5

# Time window for rate limiting in minutes
# Failed login attempts are counted within this time window
# Default: 15 (minutes)
RATE_LIMIT_WINDOW_MINUTES=15

# Initial authentication index to use on startup
INITIAL_AUTH_INDEX=0

# ===================================
# UI Configuration
# ===================================

# Custom favicon URL for the web interface
# Supports any image format (ICO, PNG, SVG, etc.) and any size
# Common sizes: 16x16, 32x32, 48x48 (ICO/PNG) or vector (SVG)
# Default: /AIStudio_logo.svg (local SVG icon)
# Example: https://example.com/favicon.ico
# If not set, the default local icon will be used
ICON_URL=

# Upstream version/image checks do not describe this independently maintained build.
# Keep disabled; update this version with git pull and a local rebuild.
CHECK_UPDATE=false

# ===================================
# Logging Configuration
# ===================================

# Server log level
# Supported values: INFO, DEBUG
# Default: INFO
LOG_LEVEL=INFO

# Timezone used for logs and displayed times
# Example: Asia/Shanghai, America/New_York, Europe/London
# If not set, defaults to the system timezone
TZ=

# ===================================
# Browser Configuration
# ===================================

# Path to the Camoufox browser executable
# Leave empty to use the default path based on your OS
CAMOUFOX_EXECUTABLE_PATH=

# Independent account login queue (single management instance only).
ACCOUNT_AUTO_RELOGIN_ENABLED=true
ACCOUNT_LOGIN_CONCURRENCY=1
# 连续任务复用独立登录浏览器；Context 每次新建。默认关闭，开启后观察资源压力。
ACCOUNT_LOGIN_BROWSER_REUSE=false
ACCOUNT_LOGIN_BROWSER_IDLE_TIMEOUT_MS=60000
ACCOUNT_LOGIN_BROWSER_MAX_ATTEMPTS=20
ACCOUNT_LOGIN_BROWSER_MAX_AGE_MS=1800000
# Random bounded pauses, sequential key events and interpolated pointer clicks.
ACCOUNT_LOGIN_HUMANIZE=true
ACCOUNT_LOGIN_QUEUE_LIMIT=1000
ACCOUNT_LOGIN_STEP_TIMEOUT_MS=30000
ACCOUNT_LOGIN_ATTEMPT_TIMEOUT_MS=180000
ACCOUNT_LOGIN_RECOVERY_TIMEOUT_MS=900000
ACCOUNT_LOGIN_MAX_ATTEMPTS=3
ACCOUNT_LOGIN_SCREENSHOT_TIMEOUT_MS=5000
ACCOUNT_LOGIN_CLEANUP_TIMEOUT_MS=10000
ACCOUNT_STORE_PATH=./data/accounts.sqlite
ACCOUNT_LOGIN_ARTIFACT_DIR=./data/account-login-artifacts
ACCOUNT_LOGIN_SCREENSHOT_RETENTION_DAYS=7
ACCOUNT_LOGIN_SCREENSHOTS_PER_ACCOUNT=10
ACCOUNT_LOGIN_LOG_RETENTION_DAYS=30

# Maximum number of accounts that can be logged in simultaneously
# Accounts logged in simultaneously can switch faster without re-login
# Higher values consume more memory (approx: 1 account ~700MB, 2 accounts ~950MB, 3 accounts ~1100MB)
# Set to 0 for unlimited
# Default: 1
MAX_CONTEXTS=1

# ===================================
# Request Handling Configuration
# ===================================

# Streaming mode: "real" (true streaming), "fake" (buffer then stream), "early" (early empty chunk)
# real / fake / early；early 仅在 OpenAI Chat Completions 流式请求发送空首块，其他协议回退 fake
# early 即使 STREAM_EARLY_HEADERS=false 也提前发送；后续错误通过 SSE 返回，HTTP 保持 200
STREAMING_MODE=real

# Maximum number of retries for failed requests
MAX_RETRIES=3

# Delay between retries in milliseconds
RETRY_DELAY=2000

# Timeout between real streaming chunks in milliseconds
# Default: 60000 (60 seconds), maximum: 300000 (300 seconds)
STREAM_TIMEOUT_MS=60000

# Timeout for fake streaming / non-streaming buffered responses in milliseconds
# Default: 300000 (300 seconds), maximum: 2147478647 (timer-safe range).
# Applies to ordinary buffered requests; MakerSuite uses its own timeout below.
FAKE_STREAM_TIMEOUT_MS=300000

# Force enable thinking mode for all requests
# When enabled, all requests will use thinking mode regardless of client settings
# Default: false
FORCE_THINKING=false

# Force enable web search for all requests
# When enabled, all requests will include web search capability
# Default: false
FORCE_WEB_SEARCH=false

# Force enable code execution for all requests
# When enabled, all requests will include code execution capability
# Default: false
FORCE_CODE_EXECUTION=false

# Force enable URL context for all requests
# When enabled, all requests will include URL context capability
# Default: false
FORCE_URL_CONTEXT=false

# Enable automatic auth credential updates
# When enabled, auth files are refreshed after successful login/account switch
# and periodically every 24 hours
# Default: true
ENABLE_AUTH_UPDATE=true

# Enable request usage statistics
# When disabled, the service will not load local stats, will not write stats,
# and /api/usage-stats will return an empty payload
# Default: true
ENABLE_USAGE_STATS=true

# SQLite request-detail storage. Relative paths resolve from the process working directory.
USAGE_DB_PATH=./data/usage-stats.sqlite
# Completed request details expire after this many continuous 24-hour days. 0 keeps them forever.
# Changing this value requires a restart; extending it cannot restore records already deleted.
USAGE_LOG_RETENTION_DAYS=30
# Automatic expiry check interval and maximum rows deleted per short transaction.
USAGE_LOG_CLEANUP_INTERVAL_MINUTES=60
USAGE_LOG_CLEANUP_BATCH_SIZE=1000

# ===================================
# Account Switching Configuration
# ===================================

# Number of requests before automatically switching accounts
# Set to 0 to disable usage-based switching
SWITCH_ON_USES=40

# Number of consecutive failures before switching accounts
# Set to 0 to disable failure-based switching
FAILURE_THRESHOLD=3

# Default Gemini safetySettings threshold used only when the incoming request does not provide safetySettings
# Supported values: HARM_BLOCK_THRESHOLD_UNSPECIFIED, BLOCK_LOW_AND_ABOVE, BLOCK_MEDIUM_AND_ABOVE, BLOCK_ONLY_HIGH, BLOCK_NONE, OFF
SAFETY_SETTINGS_THRESHOLD=OFF

# HTTP status codes that trigger immediate account switching (comma-separated)
# Common values: 429 (Too Many Requests), 503 (Service Unavailable)
# Leave empty to disable this feature
IMMEDIATE_SWITCH_STATUS_CODES=429,503

# ===================================
# Proxy Configuration
# ===================================

# HTTP proxy for outgoing requests (optional)
# Used when your server needs a proxy to access Google services
# Example: http://127.0.0.1:7890
HTTP_PROXY=

# HTTPS proxy for outgoing requests (optional)
# Usually set to the same value as HTTP_PROXY
HTTPS_PROXY=

# Addresses that should bypass the proxy (optional, comma-separated)
# The project automatically bypasses local addresses (localhost, 127.0.0.1, 0.0.0.0).
# Use this only if you need to bypass additional specific domains or IP ranges.
# Example: .example.com,192.168.1.0/24
NO_PROXY=

# Mihomo node-pool persistence and runtime paths. The feature itself is enabled
# from the authenticated management page and remains disabled by default.
PROXY_POOL_CONFIG_PATH=./data/proxy-pool.json
MIHOMO_DATA_DIR=./data/mihomo
# Source installs may point this at a local Mihomo binary. Docker images include one.
MIHOMO_PATH=

# Model-aware scheduling is the default. Use legacy to restore SWITCH_ON_USES behavior.
# different_proxy_first：新建/补充 Context 时按出口分散；请求沿用较久未使用优先
ACCOUNT_ROTATION_STRATEGY=least_recently_used
# Independent context/page workers within the existing Firefox browser.
# Defaults to MAX_CONTEXTS (or 1). Set to 6 for six simultaneous accounts.
MAX_BROWSER_WORKERS=6
# Background ready target among eligible accounts; may fall below this value (even to 0) during 429 cooldowns.
# Must be <= MAX_BROWSER_WORKERS; real requests can still initialize contexts when this is 0.
CONTEXT_POOL_MIN_READY=6
# Maximum concurrent context initializations.
CONTEXT_INIT_CONCURRENCY=2
# Maximum time allowed for the serialized BrowserContext creation step (milliseconds).
CONTEXT_CREATION_TIMEOUT_MS=120000
# Maximum time for one Playwright RPC during context initialization.
CONTEXT_OPERATION_TIMEOUT_MS=10000
# Hard deadline for the complete context initialization attempt.
CONTEXT_INIT_TOTAL_TIMEOUT_MS=180000
# Maximum time to wait while closing a timed-out BrowserContext.
CONTEXT_CLEANUP_TIMEOUT_MS=5000
# Flag the shared browser transport after this many distinct accounts time out in the window.
BROWSER_RPC_FAILURE_WINDOW_MS=60000
BROWSER_RPC_FAILURE_THRESHOLD=2
# Logical inflight requests; may exceed the context/page count.
GLOBAL_MAX_CONCURRENCY=24
# Per-context inflight cap; 0 keeps least-inflight balancing without a hard cap.
CONTEXT_MAX_CONCURRENCY=0
# 0 disables the account cap; global/model caps still apply.
ACCOUNT_MAX_CONCURRENCY=0
# Per-account per-model cap; omitted models inherit ACCOUNT_MAX_CONCURRENCY.
ACCOUNT_MODEL_MAX_CONCURRENCY={}
# Keys must be actual upstream model IDs, without tool/thinking/stream suffixes.
# MODEL_WORKER_ALLOCATION={"model-a":{"min_workers":3,"preferred_workers":5},"model-b":{"min_workers":1,"preferred_workers":1}}
MODEL_WORKER_ALLOCATION={}
MODEL_MAX_CONCURRENCY={}
ENABLE_DYNAMIC_WORKER_ALLOCATION=true
MODEL_QUEUE_SIZE=100
MODEL_QUEUE_TIMEOUT_MS=120000
# Ready-context dispatch deadline. Defaults to MODEL_QUEUE_TIMEOUT_MS when omitted.
REQUEST_DISPATCH_TIMEOUT_MS=30000
# Send validated streaming response headers immediately and keep the SSE connection alive while dispatching.
SCHEDULER_READY_CONTEXT_ONLY=true
STREAM_EARLY_HEADERS=true
STREAM_KEEPALIVE_INTERVAL_MS=10000
# Cooldowns are seconds. 403 risk control uses 1x/3x/6x/18x backoff with ±10% jitter.
RATE_LIMIT_COOLDOWN=86400
RISK_CONTROL_COOLDOWN=600
RISK_CONTROL_MAX_COOLDOWN=10800

# 每天按 America/Los_Angeles 时区清理可自动恢复的调度冷却（24 小时制 HH:mm）
SCHEDULER_DAILY_RESET_ENABLED=true
SCHEDULER_DAILY_RESET_TIME=00:00
TEMP_ERROR_COOLDOWN=30
# Retries after the first attempt (also bounds context initialization attempts).
MAX_RETRIES_PER_REQUEST=2
# Mount data/ as a persistent volume. Only one server process may use this file.
# SCHEDULER_STATE_PATH=data/scheduler-state.json

# 调度预算、背压与故障恢复（通过统一配置面板管理，修改后重启）
SCHEDULER_DRAIN_BUDGET_MS=8
GLOBAL_QUEUE_SIZE=1000
BROWSER_RECOVERY_MAX_ATTEMPTS=3
BROWSER_RECOVERY_BACKOFF_MS=5000
BROWSER_RECOVERY_STABLE_MS=300000
SUPERVISOR_HEARTBEAT_MS=5000
SUPERVISOR_TIMEOUT_MS=60000
SUPERVISOR_MAX_RESTARTS=3
SUPERVISOR_SHUTDOWN_MS=45000

# Gemini 4 Argon eligibility is managed in Accounts (manual paid tier or
# a current successful paid benefit check). ARGON_VERIFIED_ACCOUNTS is deprecated
# and ignored, including existing values. No restart is needed for tier edits.

# Exact, suffix-free model IDs; restart required. Unspecified models use legacy,
# except gemini-4-argon, which defaults to makersuite. No automatic channel fallback.
# MODEL_TRANSPORT_POLICY={"gemini-3.7-flash":"legacy","gemini-4-argon":"makersuite"}
# MakerSuite generation budget in milliseconds (1-2147478647); editable in the UI.
# Independent of FAKE_STREAM_TIMEOUT_MS; up to 5000 ms is added for response settlement.
# Sync the bundled build.js into your Build client to support waits over five minutes.
MAKERSUITE_TIMEOUT_MS=295000

# 按真实上游模型 ID 设置预热 Context 覆盖目标；默认 0，仅模型感知模式生效。
# 每项为 0..MAX_BROWSER_WORKERS-1 的整数；总和不限（同一账号可覆盖多个模型）。
# 任意目标 > 0 时，至少留一个可正常驻留和置换的共享名额；普通补池可达到 M，不强制留物理空位。
MODEL_CONTEXT_WARM_TARGETS={}
